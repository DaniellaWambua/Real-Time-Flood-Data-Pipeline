# Copy this file to backend/.env and fill in the values. backend/.env is never committed.
# It is the one secrets file for the backend, the ingestion layer and docker compose.
# DB_PASSWORD, SECRET_KEY and INTERNAL_API_TOKEN are required: the system will not start without them.

# Database (docker compose creates the database with these values the first time it starts)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=flood_pipeline
DB_USER=flood_pipeline
DB_PASSWORD=

# Long random values in production, for example from: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
INTERNAL_API_TOKEN=

# Google Sign-In (same value as VITE_GOOGLE_CLIENT_ID in frontend/.env.local)
GOOGLE_CLIENT_ID=

# Comma-separated origins allowed to call the API
FRONTEND_ORIGINS=http://localhost:5173

# Email for invites and password resets (Gmail: an app password, not the account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM_NAME=Flood Early Warning
MAIL_FROM_ADDRESS=

# The address of the React app, used in email links
FRONTEND_URL=http://localhost:5173
INVITE_LINK_HOURS=72
RESET_LINK_HOURS=2

# Sign-in protections, all optional. TRUSTED_PROXIES is the number of reverse proxies in front of the
# backend (production sets 1 in deploy/docker-compose.prod.yml). SESSION_HOURS is the longest a sign-in lasts.
# TRUSTED_PROXIES=0
# SIGN_IN_STEP_SECONDS=300
# SESSION_HOURS=12
