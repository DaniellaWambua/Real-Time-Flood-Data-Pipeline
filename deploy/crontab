# Installed on the VM with: crontab deploy/crontab   (times are UTC; 03:30 UTC is 06:30 in Nairobi)
DEPLOY=/home/azureuser/flood/deploy
30 3 * * * cd $DEPLOY && docker compose -f docker-compose.prod.yml --env-file .env run --rm producer --live >> $DEPLOY/logs/producer.log 2>&1
45 3 * * * cd $DEPLOY && docker compose -f docker-compose.prod.yml --env-file .env run --rm producer --forecast >> $DEPLOY/logs/forecast.log 2>&1
0 1 * * * $DEPLOY/backup.sh >> $DEPLOY/logs/backup.log 2>&1
