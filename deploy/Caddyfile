# Public entry point. Caddy obtains and renews the HTTPS certificate automatically.
# The dashboard is served from the built React files; the API sits under /backend on the same address,
# so the session cookie stays first-party. The internal scoring endpoint is never exposed.
{$SITE_ADDRESS} {
	encode gzip

	# Browser protections for every response, the API included.
	# The policy allows this site's own files plus what Google sign-in and the OpenStreetMap tiles need.
	# Inline styles stay allowed because Google's sign-in button sets its own.
	header {
		Strict-Transport-Security "max-age=31536000"
		Content-Security-Policy "default-src 'self'; script-src 'self' https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline' https://accounts.google.com/gsi/style; img-src 'self' data: blob: https://*.tile.openstreetmap.org https://*.googleusercontent.com; font-src 'self'; connect-src 'self' https://accounts.google.com/gsi/; frame-src https://accounts.google.com/gsi/; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		-Server
	}

	handle /backend/internal/* {
		respond 404
	}

	handle_path /backend/* {
		reverse_proxy backend:5001
	}

	handle {
		root * /srv/dashboard
		# The page is checked for a newer version on every visit, so a deploy shows at once.
		# The built scripts and styles carry a hash in their names, so they can be kept for good.
		@page not path /assets/*
		header @page Cache-Control "no-cache"
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}

# Other names for the site (the www name and the original Azure address) send visitors to the main address,
# so sign-in and Google sign-in only ever see one origin.
{$REDIRECT_ADDRESSES} {
	redir https://{$SITE_ADDRESS}{uri} permanent
}
