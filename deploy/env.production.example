# Copy to deploy/.env on the server and fill in. deploy/.env is never committed.
# Generate each secret with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"

# The public address, for example floodews-nairobi.eastus.cloudapp.azure.com
SITE_ADDRESS=
FRONTEND_URL=https://
FRONTEND_ORIGINS=https://

DB_NAME=flood_pipeline
DB_USER=flood_pipeline
DB_PASSWORD=
SECRET_KEY=
INTERNAL_API_TOKEN=

GOOGLE_CLIENT_ID=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM_NAME=Flood Early Warning
MAIL_FROM_ADDRESS=

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Earth Engine: either a service account key placed in deploy/secrets/ ...
EE_SERVICE_ACCOUNT_KEY=
# ... or, if that is left blank, personal credentials copied to deploy/secrets/earthengine/credentials
EE_PROJECT=flood-pipeline-nairobi
